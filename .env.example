APP_NAME=serabutin-id-backend
PORT=3000
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serabutin?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_HOURS=168

# Bcrypt
BCRYPT_COST=12

# Booking
PLATFORM_FEE=5000
CANCELLATION_FEE_CUSTOMER=5000
CANCELLATION_FEE_PROVIDER=5000
# Comma-separated emails promoted to admin on startup (idempotent)
ADMIN_EMAILS=

# Ticket 8: chat backend service-to-service proxy (admin conversation
# metadata only). Empty base URL disables GET /admin/chat/conversations.
# CHAT_SERVICE_TOKEN is the shared secret: the ID backend uses it to call
# the chat backend, and the chat backend uses the same value (as its
# ID_BACKEND_SERVICE_TOKEN) to call GET /api/v1/internal/chat-access/:id.
CHAT_BACKEND_BASE_URL=
CHAT_SERVICE_TOKEN=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=http://localhost:3000/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=serabutin-uploads
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_SSL=true
STORAGE_S3_URL_PREFIX=

# Prepayment (DOKU Checkout, QRIS first)
# DOKU_MODE: disabled | mock | sandbox | production
# - disabled: prepaid bookings cannot be started (records a real failure)
# - mock:     local simulation, never allowed in production
# - sandbox:  real DOKU sandbox, needs DOKU_CLIENT_ID + DOKU_SECRET_KEY
# - production: real DOKU, needs DOKU_CLIENT_ID + DOKU_SECRET_KEY
DOKU_MODE=mock
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
# DOKU sub-account (profile id) that holds the customer money. Leave empty
# until the hub sub-account is activated; without it the funds settle on
# the main merchant account.
DOKU_HUB_ACCOUNT_ID=
# Path DOKU posts notifications to. Must match the notification URL
# configured in the DOKU dashboard.
DOKU_NOTIFICATION_PATH=/api/v1/payments/doku/webhook
# Optional: point notifications at another host (a local tunnel) for one
# request. DOKU requires the URL path to match DOKU_NOTIFICATION_PATH.
# DOKU does not accept ngrok URLs; localhost.run is their suggestion.
DOKU_OVERRIDE_NOTIFICATION_URL=
# Minutes a QRIS checkout stays payable.
PAYMENT_EXPIRY_MINUTES=60
# Public frontend URL, used for the checkout callback.
APP_PUBLIC_URL=http://localhost:5173
