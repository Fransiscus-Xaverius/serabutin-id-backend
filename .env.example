APP_NAME=serabutin-id-backend
PORT=3000
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serabutin?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_HOURS=168

# Bcrypt
BCRYPT_COST=12

# Booking
PLATFORM_FEE=5000
CANCELLATION_FEE_CUSTOMER=5000
CANCELLATION_FEE_PROVIDER=5000
# Comma-separated emails promoted to admin on startup (idempotent)
ADMIN_EMAILS=

# Ticket 8: chat backend service-to-service proxy (admin conversation
# metadata only). Empty base URL disables GET /admin/chat/conversations.
# CHAT_SERVICE_TOKEN is the shared secret: the ID backend uses it to call
# the chat backend, and the chat backend uses the same value (as its
# ID_BACKEND_SERVICE_TOKEN) to call GET /api/v1/internal/chat-access/:id.
CHAT_BACKEND_BASE_URL=
CHAT_SERVICE_TOKEN=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=http://localhost:3005/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=serabutin-uploads
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_SSL=true
STORAGE_S3_URL_PREFIX=

# Prepayment (DOKU Checkout, QRIS first)
# DOKU_MODE: disabled | mock | sandbox | production
# - disabled: prepaid bookings cannot be started (records a real failure)
# - mock:     local simulation, never allowed in production
# - sandbox:  real DOKU sandbox, needs DOKU_CLIENT_ID + DOKU_SECRET_KEY
# - production: real DOKU, needs DOKU_CLIENT_ID + DOKU_SECRET_KEY
DOKU_MODE=mock
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
# Kirim DOKU SNAP (Domestic Payouts). These are separate from the Checkout
# credentials because token requests are signed with the merchant RSA private
# key. DOKU_SNAP_CLIENT_ID and DOKU_SNAP_CLIENT_SECRET fall back to
# DOKU_CLIENT_ID and DOKU_SECRET_KEY when left empty.
# Optional: separate SNAP host. Empty falls back to DOKU_BASE_URL.
DOKU_SNAP_BASE_URL=
DOKU_SNAP_CLIENT_ID=
DOKU_SNAP_CLIENT_SECRET=
# PEM, base64-encoded PEM, \n-escaped PEM, or a path to a PEM file whose
# PUBLIC key is registered in the DOKU dashboard. Never commit this value.
DOKU_SNAP_PRIVATE_KEY=
# Channel code: 07 (bank deposit) or 11 (BI-FAST).
DOKU_PAYOUT_CHANNEL_ID=11
# Merchant account number for the SNAP balance inquiry.
DOKU_PAYOUT_SOURCE_ACCOUNT=
DOKU_PAYOUT_SENDER_FIRST_NAME=
DOKU_PAYOUT_SENDER_LAST_NAME=
DOKU_PAYOUT_SENDER_PERSONAL_ID=
DOKU_PAYOUT_SENDER_PERSONAL_ID_TYPE=KTP
DOKU_PAYOUT_SENDER_COUNTRY_CODE=ID
# Fallback customerNumber when a Mitra has no phone on the payout account.
DOKU_PAYOUT_CUSTOMER_NUMBER=
# agentKey DOKU sends on Kirim DOKU notifications. Empty disables the
# notification endpoint (polling still reconciles submitted payouts).
DOKU_PAYOUT_NOTIFICATION_AGENT_KEY=
# Path DOKU posts notifications to. Must match the notification URL
# configured in the DOKU dashboard.
DOKU_NOTIFICATION_PATH=/api/v1/payments/doku/webhook
# Optional: point notifications at another host (a local tunnel) for one
# request. DOKU requires the URL path to match DOKU_NOTIFICATION_PATH.
# DOKU does not accept ngrok URLs; localhost.run is their suggestion.
DOKU_OVERRIDE_NOTIFICATION_URL=
# Payment channels we offer at checkout, comma separated. Each slug maps to
# a DOKU channel name (qris -> QRIS, ovo -> EMONEY_OVO, ...). The channel
# must also be activated and have a notification URL in the DOKU dashboard.
DOKU_PAYMENT_METHODS=qris
# Minutes a QRIS checkout stays payable.
PAYMENT_EXPIRY_MINUTES=60
# Public frontend URL, used for the checkout callback.
APP_PUBLIC_URL=http://localhost:5173

# Encryption key for Mitra payout bank details (AES-256-GCM). REQUIRED:
# the server refuses to start without it. Generate with: openssl rand -base64 32
# Never commit a real key.
PAYOUT_ENCRYPTION_KEY=
# Which key encrypted a row; bump when rotating.
PAYOUT_ENCRYPTION_KEY_ID=v1
