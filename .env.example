APP_NAME=serabutin-id-backend
PORT=3000
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serabutin?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_HOURS=168

# Bcrypt
BCRYPT_COST=12

# Booking
PLATFORM_FEE=5000

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL=/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=serabutin-uploads
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_SSL=true
STORAGE_S3_URL_PREFIX=
