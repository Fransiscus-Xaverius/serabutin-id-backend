n(3), +			QualityRating:       3 + rng.Intn(3), +			ValueRating:         3 + rng.Intn(3), +			Comment:             randomItem(rng, reviewComments), +			CreatedAt:           now, +			UpdatedAt:           now, +		} +	} + +	return reviews +} + +var reviewComments = []string{ +	"Pelayanan sangat memuaskan!", +	"Profesional dan tepat waktu.", +	"Harganya terjangkau, kualitas bagus.", +	"Recommended banget!", +	"Cepat dan rapi. Puas!", +	"Komunikasi baik, hasil sesuai harapan.", +	"Agak lambat tapi hasilnya ok.", +	"Sudah dua kali pakai, selaluµ+Ìµ‰≈.", +	"Terima kasih, pelayanan ramah.", +	"Lumayan, masih bisa ditingkatkan.", +} diff --git a/internal/seed/reviews_test.go b/internal/seed/reviews_test.go new file mode 100644 index 0000000..82fd7a7 --- /dev/null +++ b/internal/seed/reviews_test.go @@ -0,0 +1,37 @@ +package seed + +import ( +	"testing" + +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +	"github.com/stretchr/testify/assert" +) + +func TestGenerateReviews_ReturnsCorrectCount(t *testing.T) { +	bookings := make([]model.BookingModel, 1000) +	for i := range bookings { +		bookings[i].ID = uint(i + 1) +		bookings[i].CustomerID = uint(i + 201) +		bookings[i].ServiceID = uint(i + 1) +		bookings[i].ProviderID = uint(i%200 + 1) +	} +	reviews := generateReviews(bookings) +	assert.Len(t, reviews, 1000) +} + +func TestGenerateReviews_MapsBookingFields(t *testing.T) { +	bookings := make([]model.BookingModel, 3) +	for i := range bookings { +		id := uint(i + 1) +		bookings[i] = model.BookingModel{ +			ID: id, CustomerID: id + 200, ServiceID: id, ProviderID: id%200 + 1, +		} +	} +	reviews := generateReviews(bookings) +	for i, r := range reviews { +		assert.Equal(t, bookings[i].ID, r.BookingID) +		assert.Equal(t, bookings[i].ServiceID, r.ServiceID) +		assert.Equal(t, bookings[i].CustomerID, r.CustomerID) +		assert.Equal(t, bookings[i].ProviderID, r.ProviderID) +	} +} diff --git a/internal/seed/seed.go b/internal/seed/seed.go new file mode 100644 index 0000000..86b2df5 --- /dev/null +++ b/internal/seed/seed.go @@ -0,0 +1,94 @@ +package seed + +import ( +	"fmt" +	"time" + +	"github.com/rs/zerolog/log" +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +	"gorm.io/gorm" +) + +func Seed(db *gorm.DB, bcryptCost int) error { +	start := time.Now() + +	err := db.Transaction(func(tx *gorm.DB) error { +		// 1. Users +		log.Info().Msg("Generating users...") +		users, err := generateUsers(bcryptCost) +		if err != nil { +			return fmt.Errorf("generate users: %w", err) +		} +		if err := tx.CreateInBatches(users, 100).Error; err != nil { +			return fmt.Errorf("insert users: %w", err) +		} +		log.Info().Int("count", len(users)).Str("elapsed", time.Since(start).Round(time.Millisecond).String()).Msg("Seeded users") + +		// Reload users to get assigned IDs +		var savedUsers []model.UserModel +		if err := tx.Find(&savedUsers).Error; err != nil { +			return fmt.Errorf("reload users: %w", err) +		} + +		var providers []model.UserModel +		var customers []model.UserModel +		for _, u := range savedUsers { +			if u.Role == "provider" { +				providers = append(providers, u) +			} else { +				customers = append(customers, u) +			} +		} + +		// 2. Services +		log.Info().Msg("Generating services...") +		services := generateServices(providers) +		for i := range services { +			if err := tx.Create(&services[i]).Error; err != nil { +				return fmt.Errorf("insert service %d: %w", i, err) +			} +		} +		log.Info().Int("count", len(services)).Str("elapsed", time.Since(start).Round(time.Millisecond).String()).Msg("Seeded services") + +		// Reload services to get assigned IDs +		var savedServices []model.ServiceModel +		if err := tx.Preload("Images").Preload("AddOns").Find(&savedServices).Error; err != nil { +			return fmt.Errorf("reload services: %w", err) +		} + +		// 3. Bookings +		log.Info().Msg("Generating bookings...") +		bookings := generateBookings(customers, savedServices) +		for i := range bookings { +			if err := tx.Create(&bookings[i]).Error; err != nil { +				return fmt.Errorf("insert booking %d: %w", i, err) +			} +		} +		log.Info().Int("count", len(bookings)).Str("elapsed", time.Since(start).Round(time.Millisecond).String()).Msg("Seeded bookings") + +		// Reload bookings to get assigned IDs +		var savedBookings []model.BookingModel +		if err := tx.Preload("BookingAddOns").Find(&savedBookings).Error; err != nil { +			return fmt.Errorf("reload bookings: %w", err) +		} + +		// 4. Reviews +		log.Info().Msg("Generating reviews...") +		reviews := generateReviews(savedBookings) +		if err := tx.CreateInBatches(reviews, 100).Error; err != nil { +			return fmt.Errorf("insert reviews: %w", err) +		} +		log.Info().Int("count", len(reviews)).Str("elapsed", time.Since(start).Round(time.Millisecond).String()).Msg("Seeded reviews") + +		return nil +	}) + +	if err != nil { +		return err +	} + +	log.Info(). +		Str("elapsed", time.Since(start).Round(time.Millisecond).String()). +		Msg("Seeding complete") +	return nil +} diff --git a/internal/seed/services.go b/internal/seed/services.go new file mode 100644 index 0000000..8bdb852 --- /dev/null +++ b/internal/seed/services.go @@ -0,0 +1,50 @@ +package seed + +import ( +	"fmt" +	"math/rand" +	"time" + +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +) + +func generateServices(providers []model.UserModel) []model.ServiceModel { +	rng := rand.New(rand.NewSource(time.Now().UnixNano())) +	services := make([]model.ServiceModel, 0, 1000) + +	for i := 0; i < 1000; i++ { +		provider := providers[i%len(providers)] +		category := categories[rng.Intn(len(categories))] + +		title := fmt.Sprintf("%s %s", category, randomItem(rng, []string{"Profesional", "Express", "Standar", "Premium", "Hemat"})) +		unitType := randomItem(rng, []string{"session", "item", "hour", "sqm", "pcs"}) +		basePrice := int64(50000 + rng.Intn(450000)) +		duration := 30 + rng.Intn(210) + +		service := model.ServiceModel{ +			ProviderID:      provider.ID, +			Title:           title, +			Category:        category, +			Description:     fmt.Sprintf("Layanan %s terbaik untuk Anda. Berpengalaman dan terpercaya.", title), +			UnitType:        unitType, +			BasePrice:       basePrice, +			DurationMinutes: duration, +			ServiceAreas:    provider.City + ", " + provider.Province, +			Status:          "active", +			Images: []model.ServiceImageModel{ +				{URL: fmt.Sprintf("https://picsum.photos/seed/svc%d/400/300", i*3), SortOrder: 0}, +				{URL: fmt.Sprintf("https://picsum.photos/seed/svc%d/400/300", i*3+1), SortOrder: 1}, +				{URL: fmt.Sprintf("https://picsum.photos/seed/svc%d/400/300", i*3+2), SortOrder: 2}, +			}, +			AddOns: []model.ServiceAddOnModel{ +				{Name: randomItem(rng, []string{"Garansi 30 hari", "Free konsultasi", "Laporan detail"}), Price: int64(25000 + rng.Intn(75000))}, +				{Name: randomItem(rng, []string{"Tambahan 1 jam", "Bahan free", "Prioritas"}), Price: int64(50000 + rng.Intn(100000))}, +			}, +			CreatedAt: time.Now(), +			UpdatedAt: time.Now(), +		} +		services = append(services, service) +	} + +	return services +} diff --git a/internal/seed/services_test.go b/internal/seed/services_test.go new file mode 100644 index 0000000..2ef3314 --- /dev/null +++ b/internal/seed/services_test.go @@ -0,0 +1,43 @@ +package seed + +import ( +	"testing" + +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +	"github.com/stretchr/testify/assert" +) + +func TestGenerateServices_ReturnsCorrectCount(t *testing.T) { +	providers := make([]model.UserModel, 200) +	for i := range providers { +		providers[i].ID = uint(i + 1) +	} +	services := generateServices(providers) +	assert.Len(t, services, 1000) +} + +func TestGenerateServices_AllLinkedToProviders(t *testing.T) { +	providers := make([]model.UserModel, 200) +	for i := range providers { +		providers[i].ID = uint(i + 1) +	} +	services := generateServices(providers) +	providerIDs := make(map[uint]bool) +	for _, p := range providers { +		providerIDs[p.ID] = true +	} +	for _, s := range services { +		assert.True(t, providerIDs[s.ProviderID], "service %d has unknown provider %d", s.ID, s.ProviderID) +	} +} + +func TestGenerateServices_HasImages(t *testing.T) { +	providers := make([]model.UserModel, 200) +	for i := range providers { +		providers[i].ID = uint(i + 1) +	} +	services := generateServices(providers) +	for _, s := range services { +		assert.GreaterOrEqual(t, len(s.Images), 2) +	} +} diff --git a/internal/seed/users.go b/internal/seed/users.go new file mode 100644 index 0000000..7fa0209 --- /dev/null +++ b/internal/seed/users.go @@ -0,0 +1,54 @@ +package seed + +import ( +	"fmt" +	"math/rand" +	"time" + +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +	"golang.org/x/crypto/bcrypt" +) + +func generateUsers(bcryptCost int) ([]model.UserModel, error) { +	rng := rand.New(rand.NewSource(time.Now().UnixNano())) +	users := make([]model.UserModel, 0, 1000) + +	for i := 0; i < 1000; i++ { +		firstName := randomItem(rng, firstNames) +		lastName := randomItem(rng, lastNames) +		name := firstName + " " + lastName + +		role := "customer" +		if i < 200 { +			role = "provider" +		} + +		email := fmt.Sprintf("%s.%s.%d@email.com", firstName, lastName, i) +		whatsapp := fmt.Sprintf("+628%d%d", randomInt(rng, 100000000, 999999999), randomInt(rng, 10000000, 99999999))[:16] + +		hash, err := bcrypt.GenerateFromPassword([]byte("testing123"), bcryptCost) +		if err != nil { +			return nil, fmt.Errorf("failed to hash password for user %d: %w", i, err) +		} + +		city := randomItem(rng, cities) +		province := randomItem(rng, provinces) + +		user := model.UserModel{ +			Email:     email, +			Password:  string(hash), +			Name:      name, +			WhatsApp:  whatsapp, +			Role:      role, +			Bio:       fmt.Sprintf("Halo, saya %s. Siap membantu Anda!", name), +			Address:   fmt.Sprintf("Jl. %s No. %d", randomItem(rng, firstNames), randomInt(rng, 1, 200)), +			City:      city, +			Province:  province, +			CreatedAt: time.Now(), +			UpdatedAt: time.Now(), +		} +		users = append(users, user) +	} + +	return users, nil +} diff --git a/internal/seed/users_test.go b/internal/seed/users_test.go new file mode 100644 index 0000000..6b9453e --- /dev/null +++ b/internal/seed/users_test.go @@ -0,0 +1,55 @@ +package seed + +import ( +	"testing" + +	"github.com/stretchr/testify/assert" +	"github.com/stretchr/testify/require" +) + +func TestGenerateUsers_ReturnsCorrectCount(t *testing.T) { +	users, err := generateUsers(4) +	require.NoError(t, err) +	assert.Len(t, users, 1000) +} + +func TestGenerateUsers_UniqueEmails(t *testing.T) { +	users, err := generateUsers(4) +	require.NoError(t, err) +	emails := make(map[string]bool) +	for _, u := range users { +		assert.False(t, emails[u.Email], "duplicate email: %s", u.Email) +		emails[u.Email] = true +	} +} + +func TestGenerateUsers_UniqueWhatsApp(t *testing.T) { +	users, err := generateUsers(4) +	require.NoError(t, err) +	phones := make(map[string]bool) +	for _, u := range users { +		assert.False(t, phones[u.WhatsApp], "duplicate whatsapp: %s", u.WhatsApp) +		phones[u.WhatsApp] = true +	} +} + +func TestGenerateUsers_HashedPasswords(t *testing.T) { +	users, err := generateUsers(4) +	require.NoError(t, err) +	for _, u := range users { +		assert.NotEqual(t, "testing123", u.Password) +		assert.True(t, len(u.Password) > 20, "password looks unhashed: %s", u.Password) +	} +} + +func TestGenerateUsers_ProviderCount(t *testing.T) { +	users, err := generateUsers(4) +	require.NoError(t, err) +	count := 0 +	for _, u := range users { +		if u.Role == "provider" { +			count++ +		} +	} +	assert.Equal(t, 200, count) +}
