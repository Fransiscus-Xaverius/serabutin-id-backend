okingAddOnModel{ +				Name: "Express service", Price: int64(50000 + rng.Intn(50000)), +			}) +		} + +		var addOnTotal int64 +		for _, a := range addOns { +			addOnTotal += a.Price +		} + +		subTotal := service.BasePrice + addOnTotal +		platformFee := int64(5000) +		total := subTotal + platformFee + +		booking := model.BookingModel{ +			CustomerID:    customer.ID, +			ServiceID:     service.ID, +			ProviderID:    service.ProviderID, +			ScheduleDate:  scheduleDate, +			ScheduleTime:  scheduleTime, +			Address:       fmt.Sprintf("Jl. %s No. %d", customer.City, rng.Intn(200)+1), +			Notes:         fmt.Sprintf("Tolong datang tepat waktu. Terima kasih."), +			SubTotal:      subTotal, +			PlatformFee:   platformFee, +			Total:         total, +			PaymentMethod: randomItem(rng, []string{"transfer", "cash", "qris"}), +			Status:        "completed", +			BookingAddOns: addOns, +			CreatedAt:     scheduleDate.Add(-time.Duration(rng.Intn(72)) * time.Hour), +			UpdatedAt:     scheduleDate, +		} +		bookings = append(bookings, booking) +	} + +	return bookings +} diff --git a/internal/seed/bookings_test.go b/internal/seed/bookings_test.go new file mode 100644 index 0000000..52f4349 --- /dev/null +++ b/internal/seed/bookings_test.go @@ -0,0 +1,42 @@ +package seed + +import ( +	"testing" + +	"github.com/serabutin/serabutin-id-backend/internal/repository/model" +	"github.com/stretchr/testify/assert" +) + +func TestGenerateBookings_ReturnsCorrectCount(t *testing.T) { +	customers := make([]model.UserModel, 800) +	for i := range customers { +		customers[i].ID = uint(i + 201) +		customers[i].City = "Jakarta" +		customers[i].Province = "DKI Jakarta" +	} +	services := make([]model.ServiceModel, 1000) +	for i := range services { +		services[i].ID = uint(i + 1) +		services[i].ProviderID = uint(i%200 + 1) +		services[i].BasePrice = 100000 +	} +	bookings := generateBookings(customers, services) +	assert.Len(t, bookings, 1000) +} + +func TestGenerateBookings_AllCompleted(t *testing.T) { +	custome